		annotation SummarizationSetBy = Automatic

	partition Dim_Date = calculated
		mode: import
		source =
				
				ADDCOLUMNS(
				    CALENDAR(
				        MIN(Fact_Sales[Date]),
				        MAX(Fact_Sales[Date])
				    ),
				    "Year", YEAR([Date]),
				    "Month", FORMAT([Date], "MMM"),
				    "Month Number", MONTH([Date]),
				    "Quarter", "Q" & FORMAT([Date], "Q"),
				    "Day", DAY([Date])
				)

	annotation PBI_Id = a3fd011bc1ce428e88c77d744d6b029e

