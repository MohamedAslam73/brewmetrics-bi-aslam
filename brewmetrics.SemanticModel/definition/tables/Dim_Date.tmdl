table Dim_Date
	lineageTag: 2d2ef37d-09f1-4317-9660-0025e1c23cf4

	column Date
		formatString: General Date
		lineageTag: 7bcb3553-de4b-495b-918a-0df40670e916
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

		variation Variation
			isDefault
			relationship: d9d04c06-ee85-42ca-a5ee-7539dc9edb60
			defaultHierarchy: LocalDateTable_9a9b1ed8-236e-4867-98af-d0941114110f.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

	column Year
		formatString: 0
		lineageTag: 0a9f32e8-d880-41c3-85fb-d58f3bcfec70
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Year]

		annotation SummarizationSetBy = Automatic

	column Month
		lineageTag: de977795-24d9-41f5-b5db-b166c3f1cb5b
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month]

		annotation SummarizationSetBy = Automatic

	column 'Month Number'
		formatString: 0
		lineageTag: 444652b2-056f-45b6-8a09-59b08d6412ad
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Month Number]

